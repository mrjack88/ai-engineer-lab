{
  "name": "ai-engineer-lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "9.0" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "ms-toolsai.jupyter", "ms-python.python"]
    }
  },
  "postCreateCommand": "pip install --user pandas matplotlib jupyter"
}
